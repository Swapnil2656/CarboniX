# ─── CarboniX Web Dashboard — Vercel Environment Variables ─────────────────
# Copy these into Vercel → Your Project → Settings → Environment Variables

# ⚠️ CRITICAL: Replace "your-app.vercel.app" with your actual Vercel deployment URL
NEXTAUTH_URL="https://your-app.vercel.app"

# ⚠️ CRITICAL: DATABASE_URL must use pooler URL with pgbouncer=true (no channel_binding)
DATABASE_URL="postgresql://user:password@ep-example-pooler.c-2.ap-southeast-1.aws.neon.tech/carboniX?sslmode=require&pgbouncer=true"

# Auth secrets — BOTH are required (NextAuth v4 uses NEXTAUTH_SECRET, v5 uses AUTH_SECRET)
NEXTAUTH_SECRET="your_nextauth_secret_placeholder_32_chars"
AUTH_SECRET="your_nextauth_secret_placeholder_32_chars"

JWT_SECRET="your_jwt_secret_placeholder_32_chars"
GEMINI_API_KEY="your_new_gemini_api_key_here"
EMISSIONS_API_KEY="em_live_placeholder_key"
USE_MOCK_AGENTS=true
USE_STATIC_GRID_DATA=true
CARBON_BUDGET_KG_DAY=10
# AES-256-GCM key for encrypting stored platform tokens (32 bytes as hex)
# ⚠️ NEVER commit a real value here. Set the actual key in Vercel → Environment Variables.
TOKEN_ENCRYPTION_KEY="your_token_encryption_key_64_char_hex_placeholder"

MAIL_USER="your-email@gmail.com"
MAIL_PASS="your_gmail_app_password_here"
MAIL_FROM_NAME="CarboniX Team"
