# ─── CarboniX Web Dashboard — Vercel Environment Variables ─────────────────
# Copy these into Vercel → Your Project → Settings → Environment Variables
# Set scope to "Production"

# Database (same Neon Postgres)
DATABASE_URL=postgresql://neondb_owner:your-password@ep-xxx.neon.tech/carboniX?sslmode=require

# Auth
JWT_SECRET=your-jwt-secret-here
NEXTAUTH_SECRET=your-jwt-secret-here
NEXTAUTH_URL=https://your-app.vercel.app

# AI
GEMINI_API_KEY=your-gemini-api-key

# Carbon Grid API
EMISSIONS_API_KEY=em_live_BRnhlaMwNsojVQqErueNPGvS36XXrZ1VV6Eo7S

# Agents — use mock on web dashboard (agents run on API server)
USE_MOCK_AGENTS=true
USE_STATIC_GRID_DATA=true

# Carbon budget
CARBON_BUDGET_KG_DAY=10

# Email
MAIL_USER=swapnilsen2656@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM_NAME=CarboniX Team
