{
  "expo": {
    "name": "Carbonix",
    "slug": "carbonix",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "carbonix",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#131313",
    "splash": {
      "image": "./assets/carbonix-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#131313"
    },
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.carbonix.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.carbonix.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0A0F1C"
      },
      "navigationBar": {
        "backgroundColor": "#000000"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ebbe3a1f-aa6f-4b39-bc86-cb44a564e14b"
      }
    },
    "owner": "swapnilsen"
  }
}
