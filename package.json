{
  "name": "carbonix",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:studio": "cd services/api && npx prisma studio"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "prisma": {
    "schema": "services/api/prisma/schema.prisma"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "prisma": "^5.22.0",
    "turbo": "^1.13.0"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  }
}
