{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "strict": true,
    "moduleResolution": "node16",
    "target": "ES2022",
    "module": "Node16"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
