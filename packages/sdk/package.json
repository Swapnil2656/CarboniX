{
  "name": "carbonix",
  "version": "1.0.0",
  "description": "Official Node.js SDK for CarboniX — cloud carbon footprint tracking, AI recommendations, and live telemetry ingestion.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "scripts/",
    "README.md"
  ],
  "keywords": ["carbon", "cloud", "aws", "gcp", "azure", "sustainability", "green-cloud", "emissions"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "echo \"No tests yet\" && exit 0",
    "lint": "tsc --noEmit",
    "postinstall": "node scripts/postinstall.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}


