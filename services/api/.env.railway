# ─── CarboniX API — Railway Environment Variables ──────────────────────────
# Copy these into Railway → Your Service → Variables tab
# DO NOT commit actual values to git

# Database (your Neon Postgres — copy from your local .env)
DATABASE_URL=postgresql://neondb_owner:your-password@ep-xxx.neon.tech/carboniX?sslmode=require

# Auth & Security
JWT_SECRET=your-jwt-secret-here

# AI
GEMINI_API_KEY=your-gemini-api-key

# Carbon Grid API
EMISSIONS_API_KEY=em_live_BRnhlaMwNsojVQqErueNPGvS36XXrZ1VV6Eo7S

# Agents Mode — set to false for live cloud data, true for mock
USE_MOCK_AGENTS=false
USE_STATIC_GRID_DATA=false

# Carbon Budget threshold (kg/day)
CARBON_BUDGET_KG_DAY=10

# Email (optional — for notifications)
MAIL_USER=swapnilsen2656@gmail.com
MAIL_PASS=your-app-password
MAIL_FROM_NAME=CarboniX Team

# GCP (optional — for live GCP metrics)
GOOGLE_CLOUD_PROJECT=your-project-id
# Upload your service account JSON to Railway as a secret file,
# then set this to the path Railway mounts it to:
# GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcp-credentials.json

# Port — Railway sets this automatically, don't change
# PORT=4000
