# ─── CarboniX API — Railway Environment Variables ──────────────────────────
# Copy these into Railway → Your Service → Variables tab (using the Raw Editor)

DATABASE_URL="postgresql://user:password@ep-example.c-2.ap-southeast-1.aws.neon.tech/carboniX?sslmode=require&channel_binding=require"
JWT_SECRET="your_jwt_secret_placeholder_32_chars"
GEMINI_API_KEY="your_new_gemini_api_key_here"
EMISSIONS_API_KEY="em_live_placeholder_key"
USE_MOCK_AGENTS=false
USE_STATIC_GRID_DATA=false
CARBON_BUDGET_KG_DAY=10
# AES-256-GCM key for encrypting stored platform tokens (32 bytes as hex)
# ⚠️ NEVER commit a real value here. Set the actual key in Railway → Variables.
TOKEN_ENCRYPTION_KEY="your_token_encryption_key_64_char_hex_placeholder"

MAIL_USER="your-email@gmail.com"
MAIL_PASS="your_gmail_app_password_here"
MAIL_FROM_NAME="CarboniX Team"
